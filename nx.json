{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/test/**"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tools/**/*.ts"
    ]
  },
  "targetDefaults": {
    "build": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production", "{workspaceRoot}/LICENSE"],
        "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
        "options": {
          "command": "node tools/src/build-package.ts {projectRoot}"
        }
      }
    ],
    "typecheck": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default"],
        "options": {
          "command": "node node_modules/typescript7/bin/tsc -p {projectRoot}/tsconfig.json --noEmit"
        }
      }
    ],
    "lint": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default"],
        "options": {
          "command": "eslint . --max-warnings=0",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "test": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default"],
        "options": {
          "command": "vitest run --config {projectRoot}/vitest.config.ts"
        }
      }
    ],
    "nx-release-publish": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "options": {
          "packageRoot": "dist/{projectRoot}"
        }
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "include": ["packages/**/*"],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    }
  ],
  "release": {
    "projects": ["turbo-atomizer"],
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "currentVersionResolver": "disk",
      "adjustSemverBumpsForZeroMajorVersion": false,
      "versionActionsOptions": {
        "installIgnoreScripts": true
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false
      }
    }
  },
  "analytics": false
}
