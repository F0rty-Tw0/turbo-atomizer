{
  "name": "doctor",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "doctor",
      "workspaces": [
        "apps/*",
        "tools/*"
      ]
    },
    "apps/e2e": {
      "dependencies": {
        "web": "*"
      }
    },
    "apps/web": {},
    "tools/e2e-atoms": {
      "version": "0.0.0"
    },
